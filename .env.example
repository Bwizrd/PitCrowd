# Optional. Nothing in this file is needed to run the floor.
#
# Looking for the Jev key? It goes in jevfloor_learning_day/.env, not here:
#   cp jevfloor_learning_day/.env.example jevfloor_learning_day/.env
#
# This repo-root .env is read only by the research tools `replay` and `jev_score`, which play
# back recorded ticks from your own InfluxDB. Copy it to .env (git-ignored) and fill it in:
#   cp .env.example .env
# Another location: set OPENCRY_ENV_FILE=/path/to/file.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=
