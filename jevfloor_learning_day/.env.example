# Optional. Copy this file to .env (same folder) and fill in your key to use Jev itself:
#   cp jevfloor_learning_day/.env.example jevfloor_learning_day/.env
# .env is git-ignored. Only the local relay (jev_relay) reads the key; it never reaches the browser.
# Without a key the floor still runs and uses a free rule of thumb in place of Jev.
# Jev is TypeSafe AI's paid API, charged per call: https://docs.typesafe.ai/
JEV_KEY=
